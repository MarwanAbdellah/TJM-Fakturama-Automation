# Copy to .env (git-ignored) and fill in. A variable set in the shell overrides this file.

# Opt-in AI fallback for order layouts the local parser cannot read.
# Any OpenAI-compatible chat-completions API; the default is OpenRouter (key from openrouter.ai/keys).
VLM_API_KEY=
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=nvidia/nemotron-3.5-super-vl

# Local alternative (no key, the image stays on this PC):
# VLM_BASE_URL=http://localhost:11434/v1
# VLM_MODEL=<a vision model you pulled in Ollama>

# Fakturama: found automatically (running Fakturama.exe, where it last ran, PATH, registry,
# Program Files). Set these only if that fails or you use another workspace.
# FAKTURAMA_HOME=C:\path\to\Fakturama2
# FAKTURAMA_WORKSPACE=C:\Users\<you>\.fakturama2_test
# FAKTURAMA_WORKDIR=D:\Fakturama_Test_Working

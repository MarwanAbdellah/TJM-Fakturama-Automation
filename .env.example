# Copy to .env (git-ignored) and fill in. A variable set in the shell overrides this file.

# Opt-in AI fallback for order layouts the local parser cannot read.
# Any OpenAI-compatible chat-completions API; the default is Gemini (key from Google AI Studio).
VLM_API_KEY=
VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VLM_MODEL=gemini-3.6-flash

# Local alternative (no key, the image stays on this PC):
# VLM_BASE_URL=http://localhost:11434/v1
# VLM_MODEL=<a vision model you pulled in Ollama>

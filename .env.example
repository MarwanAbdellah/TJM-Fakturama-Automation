# Copy to .env (git-ignored). Only the AI key is needed, and only if you turn the AI
# fallback on. Everything about Fakturama is detected automatically.
# A variable set in the shell overrides this file.

# Opt-in AI fallback for order layouts the local parser cannot read.
# Any OpenAI-compatible chat-completions API; the default is OpenRouter (key from openrouter.ai/keys).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl

# Local alternative (no key, the image stays on this PC):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<a vision model you pulled in Ollama>

# --- Not needed normally ---------------------------------------------------------
# Fakturama's folder, workspace, working directory and database are detected (running
# Fakturama.exe, where it last ran, PATH, registry, Program Files; the workspace's own
# preferences). Leave these commented unless detection reports it cannot find them.
# FAKTURAMA_HOME=C:\path\to\Fakturama2
# FAKTURAMA_WORKSPACE=C:\Users\<you>\.fakturama2_test
# FAKTURAMA_WORKDIR=D:\Fakturama_Test_Working
